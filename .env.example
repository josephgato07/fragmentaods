# =============================================================================
# FRAGMENTADOS · Variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube al repositorio (está en .gitignore).
# =============================================================================

# Origen de los contenidos: "supabase" o "demo" (datos de muestra locales).
CONTENT_SOURCE=supabase

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (empieza con sb_publishable_)
# Es pública por diseño: los permisos los imponen las políticas RLS.
# Si tu proyecto todavía muestra claves "legacy", podés usar la "anon public".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# URL pública del portal (metadatos y enlaces para compartir).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NUNCA pongas aquí la clave secreta (sb_secret_…) ni la service_role.
# Esta etapa no la necesita. Si alguna vez se requiere, irá en una variable SIN
# el prefijo NEXT_PUBLIC_ y solo en el servidor.
# -----------------------------------------------------------------------------
